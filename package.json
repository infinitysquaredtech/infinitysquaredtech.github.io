{
  "name": "infinity-squared-website",
  "version": "0.1.0",
  "scripts": {
    "build:app": "npx babel app.min.js --out-file lib/app.min.js --minified",
    "build:components": "npx babel components/ --out-dir lib/components --minified",
    "build:pages": "npx babel pages/ --out-dir lib/pages --minified",
    "build:utils": "npx babel utils/ --out-dir lib/utils --minified",
    "build:tailwind": "npx tailwindcss -o tail.min.css --minify",
    "build": "npm-run-all build:app build:components build:pages build:utils build:tailwind",
    "clean": "rm -rf lib tail.min.css",
    "watch:app": "npx babel app.min.js --out-file lib/app.min.js --minified --watch",
    "watch:components": "npx babel components/ --out-dir lib/components --minified --watch",
    "watch:pages": "npx babel pages/ --out-dir lib/pages --minified --watch",
    "watch:utils": "npx babel utils/ --out-dir lib/utils --minified --watch",
    "watch:tailwind": "npx tailwindcss -o tail.min.css --minify --watch",
    "watch": "npm-run-all --parallel watch:app watch:components watch:pages watch:utils watch:tailwind"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.3",
    "@babel/core": "^7.28.4",
    "@babel/plugin-syntax-jsx": "^7.27.1",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-react": "^7.27.1",
    "npm-run-all": "^4.1.5",
    "tailwindcss": "^4.1.12"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.1.12"
  }
}
